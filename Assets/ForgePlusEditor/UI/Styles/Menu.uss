/* The menu (opened from the header) and its tabs: Files, Inputs and Settings */

.fp-menu-slot {
    width: 800px;
    min-width: 300px;
    flex-shrink: 1;
}

.fp-menu {
    flex-grow: 1;
}

.fp-menu__tabs {
    height: var(--fp-control-height);
    flex-shrink: 0;
    margin-bottom: 5px;
}

.fp-menu__tab {
    width: 100px;
    margin-right: 5px;
}

.fp-menu__content {
    flex-grow: 1;
}

/* The menu's actions (closing it) on the left, and the tab's (if it has any) on the right */
.fp-menu__actions {
    flex-direction: row;
    height: var(--fp-control-height);
    flex-shrink: 0;
    margin-top: 5px;
}

.fp-menu__action {
    width: 100px;
}

.fp-menu__tab-actions {
    flex-grow: 1;
    flex-direction: row;
}

.fp-menu__tab-actions > * {
    flex-grow: 1;
}


/* ---------- Files ---------- */

/* At the top of the file selection box, above its scroll area */
.fp-files__find {
    height: var(--fp-control-height);
    flex-shrink: 0;
    margin-bottom: 10px;
}

/* Find in Directory (40px, and its 10px gap) over the scroll area, which keeps its 460px */
.fp-files__selection {
    min-height: 530px;
    height: 530px;
    flex-shrink: 0;
    margin-bottom: 5px;
}

/* The Aleph One only Plugins and Scripts folders, and the plugins (marked with fp-aleph-one-only's stripe) */
.fp-files__mml-separator {
    margin: 10px 0 5px 0;
}

.fp-files__mml {
    padding-left: 5px;
    flex-shrink: 0;
}

.fp-files__plugin-list {
    height: var(--fp-control-height);
    margin-top: 5px;
}

.fp-files__levels {
    flex-grow: 1;
    margin: 5px 0 0 0;
}

.fp-files__actions {
    flex-direction: row;
    height: var(--fp-control-height);
    flex-shrink: 0;
}

.fp-files__load {
    width: 100px;
}

.fp-path-selector {
    flex-shrink: 0;
}

.fp-path-selector__heading {
    margin-bottom: 2px;
}

.fp-path-selector__row {
    flex-direction: row;
    height: var(--fp-control-height);
}

.fp-path-selector__button {
    width: 80px;
    flex-shrink: 0;
}

.fp-path-selector__path {
    flex-grow: 1;
    flex-shrink: 1;
}

/* The level list is a ListView whose items look like toggles, with the selected item's indicator filled */
.fp-level-list .unity-collection-view__item,
.fp-level-list .unity-collection-view__item:hover,
.fp-level-list .unity-collection-view__item--selected,
.fp-level-list .unity-collection-view__item--selected:hover {
    background-color: rgba(0, 0, 0, 0);
    padding: 0;
}

.fp-level-list .unity-collection-view__item:focus {
    border-width: 0;
}

.fp-level-item {
    flex-direction: row;
    height: var(--fp-control-height);
    margin-bottom: 5px;
    background-color: var(--fp-control);
}

.fp-level-item:hover {
    background-color: var(--fp-control-hover);
}

.fp-level-item__indicator {
    width: 35px;
    flex-shrink: 0;
    background-color: var(--fp-indicator-frame);
    border-color: var(--fp-indicator-frame);
}

.fp-level-item__label {
    flex-grow: 1;
    margin: 0;
    padding: 0 5px;
    color: var(--fp-control-text);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

/* ---------- Errors (in the menu's place) ---------- */

.fp-errors__tab {
    width: 130px;
}

.fp-errors__list {
    flex-grow: 1;
}

.fp-errors__empty {
    flex-grow: 1;
    margin: 0;
    color: var(--fp-text-faint);
    -unity-text-align: middle-center;
}

/* An error's text and, if it has one, its fix: a level item's look, twice as tall */
.fp-error-item {
    flex-direction: row;
    height: 85px;
    margin-bottom: 5px;
    background-color: var(--fp-control);
}

.fp-error-item__description {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0;
    padding: 4px 8px;
    color: var(--fp-control-text);
    -unity-text-align: middle-left;
    white-space: normal;
    overflow: hidden;
}

/* An error's or a warning's mark, on its left edge */
.fp-error-item--error {
    border-left-width: 6px;
    border-left-color: var(--fp-error);
}

.fp-error-item--warning {
    border-left-width: 6px;
    border-left-color: var(--fp-warning);
}

.fp-errors__show-warnings {
    height: var(--fp-short-control-height);
    flex-shrink: 0;
    margin-bottom: 5px;
}

.fp-error-item__fix {
    width: 100px;
    flex-shrink: 0;
    border-left-width: 5px;
    border-color: var(--fp-panel-background);
}

/* ---------- Inputs ---------- */

/* A category's header bar, above its inputs' rows */
.fp-inputs__header {
    height: 28px;
    margin: 5px 0 0 0;
    padding: 0 5px;
    background-color: var(--fp-header);
    color: var(--fp-text-light);
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* An input's name, its bindings, then its reset */
.fp-inputs__row {
    flex-direction: row;
    align-items: center;
    min-height: var(--fp-short-control-height);
}

.fp-inputs__label {
    width: 220px;
    flex-shrink: 0;
    margin: 0;
    padding: 0 5px;
    color: var(--fp-text-bright);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.fp-inputs__bindings {
    flex-grow: 1;
    flex-direction: row;
    flex-wrap: wrap;
}

/* A binding (a key or button, or a combination such as Ctrl + Z) */
.fp-inputs__binding {
    flex-direction: row;
    align-items: center;
    margin: 2px 10px 2px 0;
}

.fp-inputs__key {
    min-width: 90px;
    height: var(--fp-short-control-height);
}

.fp-inputs__plus {
    margin: 0 4px;
    color: var(--fp-text-light);
    -unity-font-style: bold;
}

/* An input with a binding that conflicts with another input's (its tooltip says which), and that binding's keys */
.fp-inputs__row--conflict {
    background-color: var(--fp-warning-highlight);
    border-left-width: 6px;
    border-left-color: var(--fp-warning);
}

.fp-inputs__binding--conflict > .fp-inputs__key {
    background-color: var(--fp-warning);
}

.fp-inputs__binding--conflict > .fp-inputs__key:hover {
    background-color: var(--fp-warning-hover);
}

.fp-inputs__reset {
    width: 70px;
    height: var(--fp-short-control-height);
    flex-shrink: 0;
}

/* Over the whole UI while a binding waits for its key or button */
.fp-inputs__rebinding-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: var(--fp-blocker-fill);
}

.fp-inputs__rebinding-message {
    margin-top: 10px;
    -unity-text-align: middle-center;
}

/* ---------- Settings ---------- */

.fp-settings__options {
    flex-grow: 1;
    padding: 5px;
}

.fp-setting {
    height: var(--fp-control-height);
}

/* A setting's name, above its choices */
.fp-setting__label {
    margin: 5px 0 0 0;
    padding: 0 5px;
    color: var(--fp-text-bright);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.fp-setting__choice {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 4px;
}

.fp-setting__choice--last {
    margin-right: 0;
}

/* Reset To Defaults, centered at the bottom of the settings (below their scroll area) */
.fp-settings__actions {
    flex-direction: row;
    justify-content: center;
    height: var(--fp-control-height);
    flex-shrink: 0;
    margin-top: 5px;
}

.fp-settings__reset {
    width: 160px;
}

.fp-settings__version {
    height: 30px;
    flex-shrink: 0;
    margin: 0;
    -unity-text-align: lower-center;
}
