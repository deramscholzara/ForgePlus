/* The screen's layout: the header, the three columns between it and the manipulation bar, and the overlays */

.fp-slot {
    flex-shrink: 0;
}

/* A slot whose panel takes the rest of its column */
.fp-slot--fill {
    flex-grow: 1;
    flex-shrink: 1;
}

/* Panels fill the slots they're loaded into, except where the slot sizes to its panel */
.fp-slot--fill > .fp-panel,
.fp-header-slot > .fp-panel,
.fp-menu-slot > .fp-panel,
.fp-menu__content > .fp-panel {
    flex-grow: 1;
}

/* ---------- Header ---------- */

.fp-header-slot {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: var(--fp-short-control-height);
}

.fp-header {
    flex-direction: row;
    flex-grow: 1;
    align-items: stretch;
}

.fp-header__menu {
    width: 100px;
    flex-shrink: 0;
}

/* Between the menu and the actions (which keep their sizes), the modes centered in what room there is, and scrolled
   sideways where they don't fit */
.fp-header__modes-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin: 0 5px;
}

.fp-header__modes-scroll .unity-scroll-view__content-container {
    flex-direction: row;
    flex-grow: 1;
    min-width: 100%;
    height: 100%;
    justify-content: center;
}

.fp-header__modes,
.fp-header__other {
    flex-shrink: 0;
}

.fp-header__mode {
    width: 100px;
    margin-right: 5px;
}

.fp-header__mode--last {
    margin-right: 0;
}

.fp-header__actions {
    flex-direction: row;
    flex-shrink: 0;
}

.fp-header__action {
    width: 100px;
    margin-left: 5px;
}

/* Wide enough for its text on one line (Save Merged) */
.fp-header__action--wide {
    width: 130px;
}

/* Only as wide as its text, with room either side (Quit) */
.fp-header__action--fit {
    width: auto;
}

.fp-header__action--fit > .fp-button {
    padding: 0 15px;
}

/* Other's text is centered, as the modes' are, and a toggle's would otherwise be beside its indicator */
.fp-header__other .unity-toggle__text {
    -unity-text-align: middle-center;
}

/* On Other's right, as a dropdown's */
.fp-header__other-arrow {
    position: absolute;
    right: 8px;
    top: 9px;
    width: 12px;
    height: 12px;
    margin: 0;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--fp-control-text);
}

/* ---------- Columns ---------- */

/* 10px below the header and above the manipulation bar (each --fp-short-control-height tall) */
.fp-frame {
    position: absolute;
    left: 0;
    right: 0;
    top: 40px;
    bottom: 40px;
    flex-direction: row;
    align-items: stretch;
}

.fp-column {
    flex-shrink: 0;
}

.fp-column--left {
    width: 300px;
}

.fp-column--right {
    width: 250px;
}

.fp-flexible-space {
    flex-grow: 1;
    min-width: 10px;
}

/* Its panels are loaded at runtime, so it's hidden until they are (it would be an empty box otherwise) */
.fp-mode-settings {
    flex-shrink: 0;
    display: none;
}

.fp-mode-settings--loaded {
    display: flex;
}

/* The inspector column's box, and its visualization options above it */
.fp-inspector-column {
    flex-grow: 1;
    padding: 10px;
}

.fp-visualization {
    flex-shrink: 0;
}

.fp-visualization__options {
    flex-shrink: 0;
}

.fp-visualization__everything {
    height: var(--fp-short-control-height);
}

.fp-visualization__everything--in-grid {
    width: 100%;
    height: 35px;
    padding-bottom: 5px;
}

.fp-visualization__grid {
    flex-direction: row;
    flex-wrap: wrap;
}

/* Set apart from the grid above it */
.fp-visualization__grid--spaced {
    margin-top: 5px;
}

.fp-visualization__type {
    width: 50%;
    height: var(--fp-short-control-height);
    padding-bottom: 5px;
}

.fp-visualization__type--left {
    padding-right: 2.5px;
}

.fp-visualization__type--right {
    padding-left: 2.5px;
}

/* A row of its own (for a name too long for half of one) */
.fp-visualization__type--full {
    width: 100%;
}

/* The More Display Options dropdown, under the visualization options */
.fp-visualization__view-options {
    margin-top: 5px;
}

/* Tool modes and view options, in the right column's first box */
.fp-tool-modes {
    height: var(--fp-short-control-height);
}

.fp-tool-modes__mode {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 5px;
}

.fp-tool-modes__mode--last {
    margin-right: 0;
}

/* The Display Options dropdown, drawn as a control (whose pop-up lists the view options) */
.fp-display-options {
    height: var(--fp-short-control-height);
    margin: 0;
    flex-shrink: 0;
}

.fp-display-options > .unity-base-popup-field__input {
    margin: 0;
    padding: 0 5px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    background-color: var(--fp-control);
    color: var(--fp-control-text);
}

.fp-display-options > .unity-base-popup-field__input:hover {
    background-color: var(--fp-control-hover);
}

.fp-root .fp-display-options:focus > .unity-base-popup-field__input {
    border-color: var(--fp-focus);
}

.fp-display-options .unity-base-popup-field__text {
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.fp-display-options .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: var(--fp-control-text);
}

/* The Culling Simulation choice, under the Display Options dropdown: its name, then the dropdown filling the rest */
.fp-culling-simulation {
    flex-direction: row;
    align-items: center;
    margin-top: 5px;
    flex-shrink: 0;
}

.fp-culling-simulation__label {
    margin: 0 5px 0 0;
    padding: 0;
    color: var(--fp-text-light);
    -unity-text-align: middle-left;
}

.fp-culling-simulation__choice {
    flex-grow: 1;
    flex-basis: 0;
}

.fp-view-option {
    height: var(--fp-short-control-height);
    margin-bottom: 5px;
    flex-shrink: 0;
}

.fp-view-option--last {
    margin-bottom: 0;
}

.fp-separator--spaced {
    margin: 5px 0;
}

/* ---------- Manipulation bar ---------- */

.fp-manipulation-slot {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: var(--fp-short-control-height);
    align-items: center;
}

.fp-manipulation {
    flex-direction: row;
    height: var(--fp-short-control-height);
}

.fp-manipulation > * {
    margin-right: 10px;
}

.fp-manipulation > .fp-manipulation--last {
    margin-right: 0;
}

.fp-manipulation__frame {
    width: 140px;
}

.fp-manipulation__axis {
    width: 50px;
}

.fp-manipulation__snap {
    width: 100px;
}

.fp-manipulation__orthographic {
    width: 140px;
}

.fp-text-16 .unity-toggle__text {
    font-size: 16px;
}

.fp-text-20 .unity-toggle__text {
    font-size: 20px;
}

/* ---------- Errors toggle (in the bottom right corner), which flashes red while the level has errors the Errors
   panel isn't open for ---------- */

.fp-errors-toggle-slot {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 50px;
    height: var(--fp-short-control-height);
}

.fp-errors-toggle-slot > .fp-panel,
.fp-errors-toggle,
.fp-errors-toggle > * {
    flex-grow: 1;
}

.fp-errors-toggle {
    flex-direction: row;
}

.fp-errors-toggle--alert > .unity-toggle__input,
.fp-errors-toggle--alert:hover > .unity-toggle__input {
    background-color: rgb(210, 40, 40);
}

.fp-errors-toggle--alert .unity-toggle__text {
    color: var(--fp-text-bright);
}

/* ---------- Undo and Redo (in the bottom left corner, opposite the errors toggle) ---------- */

.fp-history-slot {
    position: absolute;
    left: 0;
    bottom: 0;
    height: var(--fp-short-control-height);
}

.fp-history-slot > .fp-panel,
.fp-history {
    flex-grow: 1;
}

.fp-history {
    flex-direction: row;
}

.fp-history__action {
    width: 70px;
    margin-right: 5px;
}

.fp-history__action--last {
    margin-right: 0;
}

/* ---------- Level name ---------- */

/* Beside the errors toggle */
.fp-level-name {
    position: absolute;
    right: 60px;
    bottom: 2px;
    margin: 0;
    padding: 0;
    -unity-text-align: lower-right;
    white-space: nowrap;
}

/* ---------- Overlays ---------- */

/* Faded in while something (such as loading or a file browser) blocks input */
.fp-input-blocker {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    border-width: 20px;
    border-color: var(--fp-blocker-border);
    opacity: 0;
    display: none;
}

.fp-input-blocker__fill {
    flex-grow: 1;
    background-color: var(--fp-blocker-fill);
}

.fp-dialog-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    display: none;
}

.fp-dialog {
    width: 300px;
    padding-bottom: 5px;
}

.fp-dialog > * {
    margin-bottom: 5px;
}

.fp-dialog__header {
    height: 30px;
    margin: 0 0 5px 0;
    background-color: var(--fp-control);
    color: var(--fp-control-text);
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.fp-dialog__option {
    height: var(--fp-short-control-height);
    margin: 0 5px 5px 5px;
}

.fp-dialog__message {
    margin: 0 5px 10px 5px;
    padding: 0 5px;
    color: var(--fp-text-bright);
    white-space: normal;
}

.fp-dialog__checkbox {
    height: var(--fp-short-control-height);
    margin: 0 5px 10px 5px;
}

/* TextInputDialog's field, and its Cancel and OK side by side */
.fp-dialog__text-field {
    height: var(--fp-short-control-height);
    margin: 0 5px 10px 5px;
}

.fp-dialog__buttons {
    flex-direction: row;
}

.fp-dialog__button {
    flex-grow: 1;
    flex-basis: 0;
}

.fp-dialog__button > .fp-button {
    height: 100%;
}

/* ---------- Name tags in the level (WorldLabels) ---------- */

/* Behind every panel, covering the view (WorldLayer, which SoundVisualization's volume bars are in too) */
.fp-world-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* Centered on its point in the level, at the UI's largest text size */
.fp-world-label {
    position: absolute;
    margin: 0;
    padding: 0;
    translate: -50% -50%;
    font-size: 24px;
    color: var(--fp-annotation);
    white-space: nowrap;
    -unity-text-align: middle-center;
}

/* What a point's move would break (or breaks), beside the point (PointHandles) */
.fp-point-status {
    position: absolute;
    margin: 0;
    padding: 2px 6px;
    background-color: var(--fp-panel-background);
    border-left-width: 4px;
    font-size: 14px;
    -unity-font-style: bold;
    white-space: nowrap;
    color: var(--fp-text-bright);
}

.fp-point-status--error {
    border-left-color: var(--fp-error);
    color: var(--fp-error);
}

.fp-point-status--warning {
    border-left-color: var(--fp-warning);
    color: var(--fp-warning);
}

.fp-world-label--selected {
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: var(--fp-text-bright);
}

/* ---------- Pop-ups over the whole UI (such as LightPicker's list of lights) ---------- */

/* Covers the UI, so a click outside the pop-up closes it */
.fp-popup-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.fp-popup {
    position: absolute;
    background-color: var(--fp-label-area);
    padding: 5px;
    border-width: 1px;
    border-color: var(--fp-indicator-frame);
}

/* TooltipLayer's tooltip, over everything, by the pointer */
.fp-tooltip {
    position: absolute;
    max-width: 400px;
    margin: 0;
    padding: 4px 8px;
    background-color: var(--fp-label-area);
    border-width: 1px;
    border-color: var(--fp-indicator-frame);
    color: var(--fp-text-light);
    white-space: normal;
}

/* ChecklistPicker's list, under its Select All and Select None */
.fp-checklist-picker__actions {
    flex-direction: row;
    flex-shrink: 0;
    margin-bottom: 5px;
}

.fp-checklist-picker__action {
    flex-grow: 1;
    flex-basis: 0;
    height: var(--fp-short-control-height);
    margin-right: 5px;
}

.fp-checklist-picker__item {
    height: var(--fp-flag-height);
}

/* ---------- Sounds' volume bars in the level (SoundVisualization) ---------- */

/* Side by side (a polygon's ambient and random sounds'), centered on their point in the level */
.fp-volume-bars {
    position: absolute;
    flex-direction: row;
    translate: -50% -50%;
}

.fp-volume-bars > .fp-volume-bar {
    margin: 0 1px;
}
