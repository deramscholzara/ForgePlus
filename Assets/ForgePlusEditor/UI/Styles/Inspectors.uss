/* Inspectors: a header, then rows of labeled values, read-only flags, subheaders and foldouts */

.fp-inspector {
    flex-shrink: 0;
    margin-bottom: 5px;
}

.fp-inspector-header {
    height: 28px;
    margin: 0;
    padding: 0 5px;
    background-color: var(--fp-header);
    color: var(--fp-text-light);
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

.fp-inspector-subheader {
    height: 18px;
    margin: 0;
    padding: 0 5px;
    background-color: var(--fp-subheader);
    color: var(--fp-text-light);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

/* A label on the left (or above, in a vertical row's instance) and its value */
.fp-inspector-row {
    flex-direction: row;
    align-items: stretch;
}

.fp-inspector-row--vertical > .fp-inspector-row {
    flex-direction: column;
    align-items: flex-start;
}

.fp-inspector-row__label {
    width: 85px;
    min-width: 85px;
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    background-color: var(--fp-label-area);
    color: var(--fp-text-light);
    -unity-text-align: upper-right;
    white-space: normal;
}

.fp-inspector-row__value-area {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 105px;
    padding-left: 5px;
    background-color: var(--fp-value-area);
}

/* Above its value, a label can be as wide as its text */
.fp-inspector-row--vertical .fp-inspector-row__label {
    width: auto;
}

.fp-inspector-row--vertical .fp-inspector-row__value-area {
    align-self: stretch;
}

/* A row that doesn't apply (such as to the selected object) is grayed out, not hidden, at full opacity (which the
   default theme lowers for disabled elements) */
.fp-inspector-row:disabled > .fp-inspector-row__label {
    color: var(--fp-text-faint);
    opacity: 1;
}

.fp-inspector-row:disabled > .fp-inspector-row__value-area {
    background-color: var(--fp-value-area-disabled);
}

.fp-inspector-row:disabled .fp-inspector-value {
    color: var(--fp-value-text-disabled);
    opacity: 1;
}

.fp-inspector-value {
    margin: 0;
    padding: 0;
    color: var(--fp-value-text);
    -unity-text-align: upper-left;
    white-space: normal;
}

/* A text or number field in a row's value area, looking like the row's value (its border only shows focus) */
.fp-inspector-text-field {
    margin: 0;
    padding: 0;
}

.fp-inspector-text-field > .unity-base-text-field__input {
    margin: 0;
    padding: 0;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--fp-value-text);
}

.fp-inspector-row:disabled .fp-inspector-text-field,
.fp-inspector-row:disabled .fp-inspector-text-field > .unity-base-text-field__input {
    opacity: 1;
    color: var(--fp-value-text-disabled);
}

/* A dropdown in a row's value area, looking like the row's value (its border only shows focus) */
.fp-inspector-dropdown {
    flex-grow: 1;
    margin: 0;
    padding: 0;
}

.fp-inspector-dropdown > .unity-base-popup-field__input {
    margin: 0;
    padding: 0 2px 0 0;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--fp-value-text);
}

.fp-root .fp-inspector-dropdown:focus > .unity-base-popup-field__input {
    border-color: var(--fp-focus);
}

.fp-inspector-row:disabled .fp-inspector-dropdown,
.fp-inspector-row:disabled .fp-inspector-dropdown > .unity-base-popup-field__input {
    opacity: 1;
    color: var(--fp-value-text-disabled);
}

/* An annotation in the annotations list, which is selected by clicking it */
.fp-annotation {
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
}

.fp-annotation--selected {
    border-color: var(--fp-focus);
}

.fp-inspector-texture {
    width: 170px;
    height: 170px;
    -unity-background-scale-mode: scale-to-fit;
}

.fp-inspector-flag {
    height: var(--fp-flag-height);
}

/* Data only Aleph One supports (the original Marathon 2 and Infinity ignore it) is marked with a stripe on its left,
   whatever it is (a tab, a heading, a flag, a note), besides saying so in its wording */
.fp-aleph-one-only {
    border-left-width: 4px;
    border-left-color: var(--fp-aleph-one);
}

.fp-aleph-one-only.fp-inspector-note {
    color: var(--fp-aleph-one);
}

/* The Level inspector's tabs, wrapping onto as many rows as they need */
.fp-level-tabs {
    margin: 5px 0;
}

.fp-level-tabs #contentContainer {
    flex-wrap: wrap;
}

.fp-level-tabs__tab {
    height: var(--fp-short-control-height);
    margin: 0 4px 4px 0;
    padding: 0 6px;
}

/* Text to read, such as a script, in the value area's colors */
.fp-inspector-text-block {
    margin-top: 5px;
    padding: 5px;
    background-color: var(--fp-value-area);
}

.fp-inspector-text-block__text {
    white-space: normal;
    font-size: 11px;
}

/* A sentence explaining an inspector (or a section of one) */
.fp-inspector-note {
    margin: 2px 0 5px 0;
    padding: 0 5px;
    color: var(--fp-text-faint);
    white-space: normal;
}

/* A choice of one: its label, then its options as flags */
.fp-inspector-choice-area {
    margin-bottom: 5px;
}

.fp-inspector-choice__label {
    margin: 0 0 2px 0;
    padding: 0;
    color: var(--fp-text-light);
}

.fp-inspector-choice-area:disabled > .fp-inspector-choice__label {
    color: var(--fp-text-faint);
}

.fp-inspector-choice__option {
    height: var(--fp-flag-height);
    margin: 0 0 2px 0;
}

.fp-inspector-choice__option .unity-radio-button__text {
    -unity-text-align: middle-left;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.fp-inspector-action {
    height: var(--fp-short-control-height);
}

/* The foldout's header looks like a subheader, with a small indicator that fills while it's open */
.fp-inspector-foldout {
    margin: 0;
    padding: 0;
}

.fp-inspector-foldout > .unity-foldout__toggle {
    height: 18px;
    margin: 0 0 5px 0;
    padding: 0;
    background-color: var(--fp-subheader);
}

.fp-inspector-foldout > .unity-foldout__toggle > .unity-toggle__input {
    flex-grow: 1;
    align-items: stretch;
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.fp-root .fp-inspector-foldout > .unity-foldout__toggle > .unity-toggle__input > .unity-foldout__checkmark {
    width: 15px;
    height: auto;
    align-self: stretch;
    margin: 0;
    background-image: none;
    background-color: var(--fp-indicator-frame);
    border-color: var(--fp-indicator-frame);
    border-width: 0;
    rotate: none;
}

.fp-inspector-foldout .unity-foldout__text {
    flex-grow: 1;
    margin: 0;
    padding: 0 5px;
    color: var(--fp-text-light);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.fp-inspector-foldout > .unity-foldout__content {
    margin: 0;
    padding: 0;
}

/* A light's index and a preview of its intensity (LightIndexField), in a row's value area, looking like the row's
   value (its border only shows focus), which opens a list of the level's lights (LightPicker) */
.fp-inspector-light {
    flex-grow: 1;
    margin: 0;
    padding: 0;
}

.fp-light-field__input {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    margin: 0;
    padding: 0 2px 0 0;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    color: var(--fp-value-text);
}

.fp-root .fp-inspector-light:focus > .fp-light-field__input {
    border-color: var(--fp-focus);
}

.fp-light-field__index {
    min-width: 30px;
    margin: 0;
    padding: 0;
    color: var(--fp-value-text);
}

.fp-light-field__preview {
    flex-grow: 1;
    height: 12px;
    margin: 0 5px;
    border-width: 1px;
    border-color: var(--fp-indicator-frame);
}

.fp-inspector-row:disabled .fp-inspector-light {
    opacity: 1;
}

.fp-inspector-row:disabled .fp-light-field__index {
    color: var(--fp-value-text-disabled);
}

.fp-inspector-row:disabled .fp-light-field__arrow {
    visibility: hidden;
}

/* A slider and a number field for the same value, side by side */
.fp-inspector-slider {
    flex-grow: 1;
    margin: 0 5px 0 0;
}

.fp-inspector-slider-number {
    width: 50px;
    flex-shrink: 0;
}

/* A chapter screen's preview, as wide as the inspector, keeping its shape */
.fp-chapter-screen {
    -unity-background-scale-mode: scale-to-fit;
}

.fp-chapter-screen--off {
    opacity: 0.35;
}

.fp-inspector-row__value-area--row {
    flex-direction: row;
    align-items: center;
}

/* Rows added to a list in an inspector, spaced as the inspector's own are */
.fp-inspector-list > * {
    margin-bottom: 5px;
    flex-shrink: 0;
}

/* A range's fields share the value area, with "to" between them; the second looks like the first */
.fp-inspector-range-field {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
}

.fp-inspector-range-separator {
    flex-shrink: 0;
    padding: 0 5px;
    margin: 0;
    color: var(--fp-value-text);
    -unity-text-align: middle-center;
}

.fp-inspector-range-maximum {
    margin: 0;
    padding: 0;
}

.fp-inspector-range-maximum > .unity-base-text-field__input {
    margin: 0;
    padding: 0;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--fp-value-text);
}

.fp-inspector-row:disabled .fp-inspector-range-maximum,
.fp-inspector-row:disabled .fp-inspector-range-maximum > .unity-base-text-field__input {
    opacity: 1;
    color: var(--fp-value-text-disabled);
}

/* A button in a row's value area, looking like the row's value */
.fp-inspector-row-button {
    flex-grow: 1;
    margin: 0;
    padding: 0 2px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--fp-value-text);
    -unity-text-align: middle-left;
}

.fp-inspector-row-button:hover {
    border-color: var(--fp-focus);
}

/* A grayed-out row's button reads as its value does */
.fp-inspector-row:disabled .fp-inspector-row-button {
    color: var(--fp-value-text-disabled);
}
