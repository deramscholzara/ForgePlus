/* The palette: textures, lights or media for the current mode */

.fp-palette {
    flex-grow: 1;
}

.fp-palette__box {
    flex-grow: 1;
    padding: 10px;
}

/* Textures sit two to a row, and landscapes (which are wide) get a row each */
.fp-palette__swatches--textures {
    flex-direction: row;
    flex-wrap: wrap;
}

.fp-swatch-slot {
    width: 50%;
}

/* The pair splits the 5px gap between them */
.fp-swatch-slot--left {
    padding-right: 2.5px;
}

.fp-swatch-slot--right {
    padding-left: 2.5px;
}

.fp-swatch-slot--full {
    width: 100%;
}

/* Four to a row (in the texture picker), splitting the 4px gaps between them */
.fp-swatch-slot--quarter {
    width: 25%;
    padding-left: 2px;
    padding-right: 2px;
}

/* Swatches are toggles with their own content drawn over them */
.fp-swatch {
    height: var(--fp-short-control-height);
}

.fp-swatch--texture {
    height: 80px;
}

.fp-swatch__content {
    position: absolute;
    margin: 0;
    padding: 0;
    color: var(--fp-control-text);
    -unity-font-style: bold;
}

.fp-root .fp-swatch--texture > .unity-toggle__input > .unity-toggle__checkmark {
    margin-bottom: 20px;
}

.fp-swatch__texture-label {
    left: 5px;
    right: 5px;
    bottom: 4px;
    height: 15px;
    font-size: 12px;
    -unity-text-align: lower-left;
    white-space: nowrap;
}

.fp-swatch__preview {
    left: 35px;
    right: 5px;
    top: 5px;
    bottom: 20px;
    -unity-background-scale-mode: scale-to-fit;
}

.fp-swatch__in-use {
    left: 0;
    right: 0;
    bottom: 0;
    height: 5px;
    background-color: var(--fp-in-use);
}

.fp-swatch__index {
    left: 35px;
    top: 5px;
    bottom: 5px;
    -unity-text-align: middle-left;
}

.fp-swatch__light-preview {
    left: 60px;
    right: 5px;
    top: 5px;
    bottom: 5px;
}

/* A swatch's type (of media, or of platform) after its index */
.fp-swatch__media-type,
.fp-swatch__platform-type {
    left: 80px;
    right: 5px;
    top: 5px;
    bottom: 5px;
    -unity-text-align: middle-left;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

/* An ambient or random sound's swatch: its sound after its index, and a button to play it and a bar of its volume at
   its right */
.fp-swatch__sound {
    left: 70px;
    right: 42px;
    top: 5px;
    bottom: 5px;
    -unity-text-align: middle-left;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

/* A sound swatch's play button, left of its volume bar: just its triangle, over the swatch */
.fp-swatch .fp-swatch__play {
    position: absolute;
    right: 20px;
    top: 4px;
    bottom: 7px;
    width: 18px;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 2px;
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
    color: var(--fp-control-text);
}

.fp-swatch .fp-swatch__play:hover {
    background-color: var(--fp-indicator-frame);
}

.fp-swatch .fp-swatch__play:hover:active {
    background-color: var(--fp-indicator-on);
}

.fp-swatch .fp-swatch__play:disabled {
    opacity: 0.3;
}

.fp-swatch__volume {
    right: 6px;
    top: 4px;
    bottom: 7px;
    width: 10px;
}

/* A volume bar (in a swatch, or over the level): a frame, filled from the bottom (to its fill's height) */
.fp-swatch__volume,
.fp-volume-bar {
    border-width: 1px;
    border-color: var(--fp-control-text);
    background-color: var(--fp-label-area);
}

.fp-volume-bar__fill {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 0;
    background-color: var(--fp-annotation);
}

/* How much higher a random sound's volume can be (from its volume, up to the top of this) */
.fp-volume-bar__range {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 0;
    background-color: var(--fp-indicator-on);
}

/* The Sounds palette's buttons, under each list */
.fp-sound-palette__actions {
    flex-direction: row;
    flex-shrink: 0;
    margin: 0 0 15px 0;
}

.fp-sound-palette__action {
    flex-grow: 1;
    flex-basis: 0;
    height: var(--fp-short-control-height);
    margin-right: 5px;
}

.fp-sound-palette__action--last {
    margin-right: 0;
}
