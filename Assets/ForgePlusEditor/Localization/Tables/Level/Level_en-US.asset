      data:
        m_KeyId: 2573444202507
        m_Metadata:
          m_Items: []
        m_Value: 'Aleph One only: changes to the shapes (graphics) saved in the level (ShPa), which the original Marathon 2 and Infinity ignore. Kept and saved as they are.'
