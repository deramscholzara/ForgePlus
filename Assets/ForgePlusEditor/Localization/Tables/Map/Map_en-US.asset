      type: {class: StringEntry, ns: Unity.Localization, asm: UnityEngine.LocalizationRuntimeModule}
      data:
        m_KeyId: 2572462735363
        m_Metadata:
          m_Items: []
        m_Value: Physics saved in a level, which it uses instead of the selected physics file (Files tab). Marathon Infinity and Aleph One load it; Marathon 2 doesn't.
