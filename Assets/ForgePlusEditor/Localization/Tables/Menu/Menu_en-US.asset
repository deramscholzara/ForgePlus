      data:
        m_KeyId: 2724797997531136
        m_Metadata:
          m_Items: []
        m_Value: Show Warnings
    - rid: 552786288315990083
      type: {class: StringEntry, ns: Unity.Localization, asm: UnityEngine.LocalizationRuntimeModule}
      data:
        m_KeyId: 2724797997531137
        m_Metadata:
          m_Items: []
        m_Value: 'Lists warnings (marked in yellow, after the errors): what''s legal, but probably not meant. On each time ForgePlus starts.'
    - rid: 552786288315990084
      type: {class: StringEntry, ns: Unity.Localization, asm: UnityEngine.LocalizationRuntimeModule}
      data:
        m_KeyId: 2724797997531138
        m_Metadata:
