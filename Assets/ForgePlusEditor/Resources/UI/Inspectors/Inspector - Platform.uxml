<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Template name="Header" src="../Templates/InspectorHeader.uxml" />
    <ui:Template name="Subheader" src="../Templates/InspectorSubheader.uxml" />
    <ui:Template name="Row" src="../Templates/InspectorRow.uxml" />
    <ui:Template name="IntegerFieldRow" src="../Templates/InspectorIntegerFieldRow.uxml" />
    <ui:Template name="DropdownRow" src="../Templates/InspectorDropdownRow.uxml" />
    <ui:Template name="Flag" src="../Templates/InspectorFlag.uxml" />
    <ui:Template name="Choice" src="../Templates/InspectorChoice.uxml" />
    <ui:Template name="ChoiceOption" src="../Templates/InspectorChoiceOption.uxml" />
    <ui:Template name="Button" src="../Templates/Button.uxml" />
    <!-- Bound to Inspector_Platform -->
    <ui:VisualElement class="fp-inspector">
        <ui:Instance template="Header">
            <ui:AttributeOverrides element-name="label" text="Platform" />
        </ui:Instance>
        <ui:Instance template="Row" name="Id">
            <ui:AttributeOverrides element-name="label" text="ID:" />
        </ui:Instance>
        <ui:Instance template="DropdownRow" name="Type">
            <ui:AttributeOverrides element-name="label" text="Type:" />
        </ui:Instance>
        <ui:Instance template="IntegerFieldRow" name="Tag">
            <ui:AttributeOverrides element-name="label" text="Tag:" />
        </ui:Instance>
        <ui:Instance template="IntegerFieldRow" name="Speed">
            <ui:AttributeOverrides element-name="label" text="Speed (units/tick):" />
        </ui:Instance>
        <ui:Instance template="IntegerFieldRow" name="Delay">
            <ui:AttributeOverrides element-name="label" text="Delay (ticks):" />
        </ui:Instance>
        <ui:VisualElement class="fp-space" />
        <ui:Instance template="Subheader">
            <ui:AttributeOverrides element-name="label" text="Movement" />
        </ui:Instance>
        <ui:Instance template="Choice" name="Direction">
            <ui:AttributeOverrides element-name="label" text="Moves:" />
            <ui:Instance template="ChoiceOption">
                <ui:AttributeOverrides element-name="control" text="From Floor" />
            </ui:Instance>
            <ui:Instance template="ChoiceOption">
                <ui:AttributeOverrides element-name="control" text="From Ceiling" />
            </ui:Instance>
            <ui:Instance template="ChoiceOption">
                <ui:AttributeOverrides element-name="control" text="From Floor and Ceiling" />
            </ui:Instance>
        </ui:Instance>
        <ui:Instance template="Flag" name="InitiallyActive">
            <ui:AttributeOverrides element-name="flag" text="Initially Active" />
        </ui:Instance>
        <ui:Instance template="Flag" name="InitiallyExtended">
            <ui:AttributeOverrides element-name="flag" text="Initially Extended" />
        </ui:Instance>
        <ui:Instance template="Flag" name="ExtendsFloorToCeiling">
            <ui:AttributeOverrides element-name="flag" text="Extends Floor to Ceiling" />
        </ui:Instance>
        <ui:VisualElement class="fp-space" />
        <ui:Instance template="Subheader">
            <ui:AttributeOverrides element-name="label" text="Heights" />
        </ui:Instance>
        <ui:Instance template="Flag" name="LowestIsAutomatic">
            <ui:AttributeOverrides element-name="flag" text="Automatic Lowest Height" />
        </ui:Instance>
        <ui:Instance template="IntegerFieldRow" name="Lowest">
            <ui:AttributeOverrides element-name="label" text="Lowest:" />
        </ui:Instance>
        <ui:Instance template="Flag" name="HighestIsAutomatic">
            <ui:AttributeOverrides element-name="flag" text="Automatic Highest Height" />
        </ui:Instance>
        <ui:Instance template="IntegerFieldRow" name="Highest">
            <ui:AttributeOverrides element-name="label" text="Highest:" />
        </ui:Instance>
        <ui:Instance template="Flag" name="UsesNativePolygonHeights">
            <ui:AttributeOverrides element-name="flag" text="Uses Native Polygon Heights" />
        </ui:Instance>
        <ui:Instance template="Row" name="FloorRange">
            <ui:AttributeOverrides element-name="label" text="Floor Range:" />
        </ui:Instance>
        <ui:Instance template="Row" name="CeilingRange">
            <ui:AttributeOverrides element-name="label" text="Ceiling Range:" />
        </ui:Instance>
        <ui:VisualElement class="fp-space" />
        <ui:Instance template="Subheader">
            <ui:AttributeOverrides element-name="label" text="Timing" />
        </ui:Instance>
        <ui:Instance template="Flag" name="DelaysBeforeActivation">
            <ui:AttributeOverrides element-name="flag" text="Delays Before Activation" />
        </ui:Instance>
        <ui:Instance template="Flag" name="ContractsSlower">
            <ui:AttributeOverrides element-name="flag" text="Contracts Slower" />
        </ui:Instance>
        <ui:VisualElement class="fp-space" />
        <ui:Instance template="Subheader">
            <ui:AttributeOverrides element-name="label" text="Control" />
        </ui:Instance>
        <ui:Instance template="Flag" name="IsPlayerControllable">
            <ui:AttributeOverrides element-name="flag" text="Player Controllable" />
        </ui:Instance>
        <ui:Instance template="Flag" name="IsMonsterControllable">
            <ui:AttributeOverrides element-name="flag" text="Monster Controllable" />
        </ui:Instance>
        <ui:Instance template="Flag" name="CannotBeExternallyDeactivated">
            <ui:AttributeOverrides element-name="flag" text="Can't Be Externally Deactivated" />
        </ui:Instance>
        <ui:Instance template="Flag" name="ActivatesOnlyOnce">
            <ui:AttributeOverrides element-name="flag" text="Activates Only Once" />
        </ui:Instance>
        <ui:Instance template="Flag" name="IsDoor">
            <ui:AttributeOverrides element-name="flag" text="Door" />
        </ui:Instance>
        <ui:Instance template="Flag" name="IsLocked">
            <ui:AttributeOverrides element-name="flag" text="Locked" />
        </ui:Instance>
        <ui:Instance template="Flag" name="IsSecret">
            <ui:AttributeOverrides element-name="flag" text="Secret" />
        </ui:Instance>
        <ui:VisualElement class="fp-space" />
        <ui:Instance template="Subheader">
            <ui:AttributeOverrides element-name="label" text="Obstruction" />
        </ui:Instance>
        <ui:Instance template="Flag" name="ReversesWhenObstructed">
            <ui:AttributeOverrides element-name="flag" text="Reverses When Obstructed" />
        </ui:Instance>
        <ui:Instance template="Flag" name="CausesDamage">
            <ui:AttributeOverrides element-name="flag" text="Causes Damage" />
        </ui:Instance>
        <ui:VisualElement class="fp-space" />
        <ui:Instance template="Subheader">
            <ui:AttributeOverrides element-name="label" text="Activation" />
        </ui:Instance>
        <ui:Instance template="Flag" name="DeactivatesAtEachLevel">
            <ui:AttributeOverrides element-name="flag" text="Deactivates at Each Level" />
        </ui:Instance>
        <ui:Instance template="Flag" name="DeactivatesAtInitialLevel">
            <ui:AttributeOverrides element-name="flag" text="Deactivates at Initial Level" />
        </ui:Instance>
        <ui:Instance template="Choice" name="WhenActivating">
            <ui:AttributeOverrides element-name="label" text="When Activating:" />
            <ui:Instance template="ChoiceOption">
                <ui:AttributeOverrides element-name="control" text="Leaves Adjacent Platforms" />
            </ui:Instance>
            <ui:Instance template="ChoiceOption">
                <ui:AttributeOverrides element-name="control" text="Activates Adjacent Platforms" />
            </ui:Instance>
            <ui:Instance template="ChoiceOption">
                <ui:AttributeOverrides element-name="control" text="Deactivates Adjacent Platforms" />
            </ui:Instance>
        </ui:Instance>
        <ui:Instance template="Choice" name="WhenDeactivating">
            <ui:AttributeOverrides element-name="label" text="When Deactivating:" />
            <ui:Instance template="ChoiceOption">
                <ui:AttributeOverrides element-name="control" text="Leaves Adjacent Platforms" />
            </ui:Instance>
            <ui:Instance template="ChoiceOption">
                <ui:AttributeOverrides element-name="control" text="Activates Adjacent Platforms" />
            </ui:Instance>
            <ui:Instance template="ChoiceOption">
                <ui:AttributeOverrides element-name="control" text="Deactivates Adjacent Platforms" />
            </ui:Instance>
        </ui:Instance>
        <ui:Instance template="Flag" name="ActivatesAdjacentAtEachLevel">
            <ui:AttributeOverrides element-name="flag" text="Activates Adjacent at Each Level" />
        </ui:Instance>
        <ui:Instance template="Flag" name="DoesNotActivateParent">
            <ui:AttributeOverrides element-name="flag" text="Doesn't Activate Parent" />
        </ui:Instance>
        <ui:Instance template="Flag" name="ActivatesLight">
            <ui:AttributeOverrides element-name="flag" text="Activates Light" />
        </ui:Instance>
        <ui:Instance template="Flag" name="DeactivatesLight">
            <ui:AttributeOverrides element-name="flag" text="Deactivates Light" />
        </ui:Instance>
        <ui:Instance template="Flag" name="FloodsM1" class="fp-aleph-one-only">
            <ui:AttributeOverrides element-name="flag" text="Floods (Marathon 1; Aleph One only)" />
        </ui:Instance>
        <ui:VisualElement class="fp-space" />
        <ui:Instance template="Subheader">
            <ui:AttributeOverrides element-name="label" text="Simulation Actions" />
        </ui:Instance>
        <ui:Instance template="Flag" name="SimulationActive">
            <ui:AttributeOverrides element-name="flag" text="Active" />
        </ui:Instance>
        <ui:Instance template="Button" name="obstruct" class="fp-inspector-action">
            <ui:AttributeOverrides element-name="control" text="Obstruct Extension" />
        </ui:Instance>
    </ui:VisualElement>
</ui:UXML>
