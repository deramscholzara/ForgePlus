<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Template name="Header" src="../Templates/InspectorHeader.uxml" />
    <ui:Template name="Subheader" src="../Templates/InspectorSubheader.uxml" />
    <ui:Template name="Row" src="../Templates/InspectorRow.uxml" />
    <ui:Template name="Flag" src="../Templates/InspectorFlag.uxml" />
    <ui:Template name="DropdownRow" src="../Templates/InspectorDropdownRow.uxml" />
    <ui:Template name="IntegerFieldRow" src="../Templates/InspectorIntegerFieldRow.uxml" />
    <ui:Template name="DistanceFieldRow" src="../Templates/InspectorDistanceFieldRow.uxml" />
    <ui:Template name="FloatFieldRow" src="../Templates/InspectorFloatFieldRow.uxml" />
    <ui:Template name="LightRow" src="../Templates/InspectorLightRow.uxml" />
    <!-- Bound to Inspector_Media -->
    <ui:VisualElement class="fp-inspector">
        <ui:Instance template="Header">
            <ui:AttributeOverrides element-name="label" text="@Media/Inspector.Media.Media.Label.Text" />
        </ui:Instance>
        <ui:Instance template="Row" name="Id">
            <ui:AttributeOverrides element-name="label" text="@Media/Inspector.Media.Id.Label.Text" />
        </ui:Instance>
        <ui:Instance template="DropdownRow" name="Type">
            <ui:AttributeOverrides element-name="label" text="@Media/Inspector.Media.Type.Label.Text" />
        </ui:Instance>
        <ui:Label name="TypeNote" class="fp-inspector-note fp-aleph-one-only" />
        <ui:Instance template="DistanceFieldRow" name="LowHeight">
            <ui:AttributeOverrides element-name="label" text="@Media/Inspector.Media.LowHeight.Label.Text" />
        </ui:Instance>
        <ui:Instance template="DistanceFieldRow" name="HighHeight">
            <ui:AttributeOverrides element-name="label" text="@Media/Inspector.Media.HighHeight.Label.Text" />
        </ui:Instance>
        <ui:Instance template="FloatFieldRow" name="FlowDirection">
            <ui:AttributeOverrides element-name="label" text="@Media/Inspector.Media.FlowDirection.Label.Text" />
        </ui:Instance>
        <ui:Instance template="IntegerFieldRow" name="FlowMagnitude">
            <ui:AttributeOverrides element-name="label" text="@Media/Inspector.Media.FlowMagnitude.Label.Text" />
        </ui:Instance>
        <ui:Instance template="LightRow" name="LightIndex">
            <ui:AttributeOverrides element-name="label" text="@Media/Inspector.Media.LightIndex.Label.Text" />
        </ui:Instance>
        <ui:Instance template="FloatFieldRow" name="MinimumLightIntensity">
            <ui:AttributeOverrides element-name="label" text="@Media/Inspector.Media.MinimumLightIntensity.Label.Text" />
        </ui:Instance>
        <ui:VisualElement class="fp-space" />
        <ui:Instance template="Subheader">
            <ui:AttributeOverrides element-name="label" text="@Media/Inspector.Media.Flags.Label.Text" />
        </ui:Instance>
        <ui:Instance template="Flag" name="FloorObstructsSound">
            <ui:AttributeOverrides element-name="flag" text="@Media/Inspector.Media.FloorObstructsSound.Flag.Text" />
        </ui:Instance>
    </ui:VisualElement>
</ui:UXML>
