<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Template name="Header" src="../Templates/InspectorHeader.uxml" />
    <ui:Template name="Subheader" src="../Templates/InspectorSubheader.uxml" />
    <ui:Template name="Row" src="../Templates/InspectorRow.uxml" />
    <ui:Template name="DropdownRow" src="../Templates/InspectorDropdownRow.uxml" />
    <ui:Template name="DropdownPlayRow" src="../Templates/InspectorDropdownPlayRow.uxml" />
    <ui:Template name="LightRow" src="../Templates/InspectorLightRow.uxml" />
    <!-- Bound to Inspector_Polygon -->
    <ui:VisualElement class="fp-inspector">
        <ui:Instance template="Header">
            <ui:AttributeOverrides element-name="label" text="Polygon" />
        </ui:Instance>
        <ui:Instance template="Row" name="Id">
            <ui:AttributeOverrides element-name="label" text="ID:" />
        </ui:Instance>
        <ui:Instance template="DropdownRow" name="Type">
            <ui:AttributeOverrides element-name="label" text="Type:" />
        </ui:Instance>
        <ui:Instance template="Row" name="Permutation">
            <ui:AttributeOverrides element-name="label" text="Permutation:" />
        </ui:Instance>
        <ui:VisualElement class="fp-space" />
        <ui:Instance template="Subheader">
            <ui:AttributeOverrides element-name="label" text="Floor" />
        </ui:Instance>
        <ui:Instance template="Row" name="FloorHeight">
            <ui:AttributeOverrides element-name="label" text="Height:" />
        </ui:Instance>
        <ui:Instance template="LightRow" name="FloorLightIndex">
            <ui:AttributeOverrides element-name="label" text="Light:" />
        </ui:Instance>
        <ui:VisualElement class="fp-space" />
        <ui:Instance template="Subheader">
            <ui:AttributeOverrides element-name="label" text="Ceiling" />
        </ui:Instance>
        <ui:Instance template="Row" name="CeilingHeight">
            <ui:AttributeOverrides element-name="label" text="Height:" />
        </ui:Instance>
        <ui:Instance template="LightRow" name="CeilingLightIndex">
            <ui:AttributeOverrides element-name="label" text="Light:" />
        </ui:Instance>
        <ui:VisualElement class="fp-space" />
        <ui:Instance template="Subheader">
            <ui:AttributeOverrides element-name="label" text="Media" />
        </ui:Instance>
        <ui:Instance template="Row" name="MediaIndex">
            <ui:AttributeOverrides element-name="label" text="Index:" />
        </ui:Instance>
        <ui:Instance template="LightRow" name="MediaLight">
            <ui:AttributeOverrides element-name="label" text="Light:" />
        </ui:Instance>
        <ui:VisualElement class="fp-space" />
        <ui:Instance template="Subheader">
            <ui:AttributeOverrides element-name="label" text="Sounds" />
        </ui:Instance>
        <ui:Instance template="DropdownPlayRow" name="AmbientSound" tooltip="Its entry in the level's ambient sounds (Sounds mode lists them), which it loops while the player is in it">
            <ui:AttributeOverrides element-name="label" text="Ambient:" />
        </ui:Instance>
        <ui:Instance template="DropdownPlayRow" name="RandomSound" tooltip="Its entry in the level's random sounds (Sounds mode lists them), which it plays now and then while the player is in it">
            <ui:AttributeOverrides element-name="label" text="Random:" />
        </ui:Instance>
        <ui:Instance template="Row" name="HeardSoundSources" class="fp-inspector-row--vertical" tooltip="The sound sources near enough to it to be heard in it (as the level's precalculated map indexes list them)">
            <ui:AttributeOverrides element-name="label" text="Hears Sound Sources:" />
        </ui:Instance>
    </ui:VisualElement>
</ui:UXML>
