<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Template name="Header" src="../Templates/InspectorHeader.uxml" />
    <ui:Template name="Foldout" src="../Templates/InspectorFoldout.uxml" />
    <!-- Bound to Inspector_Placements, which adds each type's placement (an Inspector_Placement, in its own foldout) to
         the items and monsters foldouts -->
    <ui:VisualElement class="fp-inspector">
        <ui:Instance template="Header">
            <ui:AttributeOverrides element-name="label" text="Object Placement" />
        </ui:Instance>
        <ui:Label text="How the level places each type of item and monster: at the start, and every 15 seconds after (monsters only when the game's options have them replenish). Selecting an object shows its type's." class="fp-inspector-note" />
        <ui:Instance template="Foldout" name="items">
            <ui:AttributeOverrides element-name="control" text="Items" />
        </ui:Instance>
        <ui:Instance template="Foldout" name="monsters">
            <ui:AttributeOverrides element-name="control" text="Monsters" />
        </ui:Instance>
    </ui:VisualElement>
</ui:UXML>
