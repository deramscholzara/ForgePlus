<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Template name="Header" src="../Templates/InspectorHeader.uxml" />
    <ui:Template name="Subheader" src="../Templates/InspectorSubheader.uxml" />
    <ui:Template name="Row" src="../Templates/InspectorRow.uxml" />
    <ui:Template name="TextFieldRow" src="../Templates/InspectorTextFieldRow.uxml" />
    <ui:Template name="TextBlock" src="../Templates/InspectorTextBlock.uxml" />
    <!-- Bound to Inspector_Map: the map file, as a whole (each level's own data is in the Level inspector) -->
    <ui:VisualElement class="fp-inspector">
        <ui:Instance template="Header">
            <ui:AttributeOverrides element-name="label" text="@Map/Inspector.Map.Map.Label.Text" />
        </ui:Instance>
        <ui:Instance template="TextFieldRow" name="Name" class="fp-inspector-row--vertical">
            <ui:AttributeOverrides element-name="label" text="@Map/Inspector.Map.Name.Label.Text" />
        </ui:Instance>
        <ui:Label text="@Map/Inspector.Map.TheNameInThe.Text" class="fp-inspector-note" />
        <ui:Instance template="Row" name="FileName">
            <ui:AttributeOverrides element-name="label" text="@Map/Inspector.Map.FileName.Label.Text" />
        </ui:Instance>
        <ui:Instance template="Row" name="LevelCount">
            <ui:AttributeOverrides element-name="label" text="@Map/Inspector.Map.LevelCount.Label.Text" />
        </ui:Instance>
        <ui:Instance template="Row" name="EmbeddedPhysicsLevelCount" tooltip="@Map/Inspector.Map.EmbeddedPhysicsLevelCount.Tooltip">
            <ui:AttributeOverrides element-name="label" text="@Map/Inspector.Map.EmbeddedPhysicsLevelCount.Label.Text" />
        </ui:Instance>
        <ui:Instance template="Row" name="FileVersion">
            <ui:AttributeOverrides element-name="label" text="@Map/Inspector.Map.FileVersion.Label.Text" />
        </ui:Instance>
        <ui:Instance template="Row" name="DataVersion">
            <ui:AttributeOverrides element-name="label" text="@Map/Inspector.Map.DataVersion.Label.Text" />
        </ui:Instance>
        <ui:Instance template="Row" name="Checksum">
            <ui:AttributeOverrides element-name="label" text="@Map/Inspector.Map.Checksum.Label.Text" />
        </ui:Instance>
        <ui:Instance template="Row" name="ParentChecksum">
            <ui:AttributeOverrides element-name="label" text="@Map/Inspector.Map.ParentChecksum.Label.Text" />
        </ui:Instance>
        <ui:VisualElement class="fp-space" />
        <ui:Instance template="Subheader">
            <ui:AttributeOverrides element-name="label" text="@Map/Inspector.Map.MacFile.Label.Text" />
        </ui:Instance>
        <ui:Label text="@Map/Inspector.Map.TheResourceForkHolds.Text" class="fp-inspector-note" />
        <ui:Instance template="Row" name="Container">
            <ui:AttributeOverrides element-name="label" text="@Map/Inspector.Map.Container.Label.Text" />
        </ui:Instance>
        <ui:Instance template="Row" name="ResourceFork">
            <ui:AttributeOverrides element-name="label" text="@Map/Inspector.Map.ResourceFork.Label.Text" />
        </ui:Instance>
        <ui:Instance template="Row" name="Version">
            <ui:AttributeOverrides element-name="label" text="@Map/Inspector.Map.Version.Label.Text" />
        </ui:Instance>
        <!-- A row for each type of resource (added by Inspector_Map) -->
        <ui:VisualElement name="resources" />
        <ui:VisualElement class="fp-space" />
        <ui:Instance template="Subheader" class="fp-aleph-one-only">
            <ui:AttributeOverrides element-name="label" text="@Map/Inspector.Map.LevelScriptAlephOne.Label.Text" />
        </ui:Instance>
        <ui:Label text="@Map/Inspector.Map.AlephOneOnlyMML.Text" class="fp-inspector-note fp-aleph-one-only" />
        <ui:Instance template="Row" name="LevelScriptSize">
            <ui:AttributeOverrides element-name="label" text="@Map/Inspector.Map.LevelScriptSize.Label.Text" />
        </ui:Instance>
        <ui:Instance template="TextBlock" name="LevelScriptText" />
    </ui:VisualElement>
</ui:UXML>
