<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Template name="Header" src="../Templates/InspectorHeader.uxml" />
    <ui:Template name="Subheader" src="../Templates/InspectorSubheader.uxml" />
    <ui:Template name="Row" src="../Templates/InspectorRow.uxml" />
    <ui:Template name="Flag" src="../Templates/InspectorFlag.uxml" />
    <ui:Template name="Button" src="../Templates/Button.uxml" />
    <!-- Bound to Inspector_Line -->
    <ui:VisualElement class="fp-inspector">
        <ui:Instance template="Header">
            <ui:AttributeOverrides element-name="label" text="@Geometry/Inspector.Line.Line.Label.Text" />
        </ui:Instance>
        <ui:Instance template="Row" name="Id" tooltip="@Geometry/Inspector.Line.Id.Tooltip">
            <ui:AttributeOverrides element-name="label" text="@Geometry/Inspector.Line.Id.Label.Text" />
        </ui:Instance>
        <ui:VisualElement class="fp-space" />
        <ui:Instance template="Subheader">
            <ui:AttributeOverrides element-name="label" text="@Geometry/Inspector.Line.Flags.Label.Text" />
        </ui:Instance>
        <ui:Instance template="Flag" name="Solid" tooltip="@Geometry/Inspector.Line.Solid.Tooltip">
            <ui:AttributeOverrides element-name="flag" text="@Geometry/Inspector.Line.Solid.Flag.Text" />
        </ui:Instance>
        <ui:Label name="SolidCaption" class="fp-inspector-note" />
        <ui:Instance template="Flag" name="Transparent" tooltip="@Geometry/Inspector.Line.Transparent.Tooltip">
            <ui:AttributeOverrides element-name="flag" text="@Geometry/Inspector.Line.Transparent.Flag.Text" />
        </ui:Instance>
        <ui:Instance template="Flag" name="Decorative" class="fp-aleph-one-only" tooltip="@Geometry/Inspector.Line.Decorative.Tooltip">
            <ui:AttributeOverrides element-name="flag" text="@Geometry/Inspector.Line.Decorative.Flag.Text" />
        </ui:Instance>
        <ui:VisualElement class="fp-space" />
        <!-- Select (or add) the side on each face with a polygon: the front one faces the camera (Inspector_Line) -->
        <ui:VisualElement class="fp-inspector-actions">
            <ui:Instance template="Button" name="front-side" class="fp-inspector-action" tooltip="@Geometry/Inspector.Line.FrontSide.Tooltip" />
            <ui:Instance template="Button" name="back-side" class="fp-inspector-action fp-inspector-actions__next" tooltip="@Geometry/Inspector.Line.BackSide.Tooltip" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
