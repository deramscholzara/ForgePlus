<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Template name="Button" src="../Templates/Button.uxml" />
    <ui:Template name="ScrollArea" src="../Templates/ScrollArea.uxml" />
    <ui:Template name="PathSelector" src="../Templates/PathSelector.uxml" />
    <ui:VisualElement class="fp-grow" picking-mode="Ignore">
        <ui:VisualElement class="fp-box fp-box--padded fp-files__selection">
            <ui:VisualElement class="fp-files__top-row">
                <ui:Instance template="Button" name="find-in-directory" class="fp-files__top-button" tooltip="@Menu/FilesTab.FindInDirectory.Tooltip">
                    <ui:AttributeOverrides element-name="control" text="@Menu/FilesTab.FindInDirectory.Control.Text" />
                </ui:Instance>
                <ui:VisualElement class="fp-grow" picking-mode="Ignore" />
                <ui:Instance template="Button" name="new-map" class="fp-files__top-button" tooltip="@Menu/FilesTab.NewMap.Tooltip">
                    <ui:AttributeOverrides element-name="control" text="@Menu/FilesTab.NewMap.Control.Text" />
                </ui:Instance>
            </ui:VisualElement>
            <ui:Instance template="ScrollArea" class="fp-grow fp-scroll--wide-spaced">
                <ui:Instance template="PathSelector" name="maps">
                    <ui:AttributeOverrides element-name="heading" text="@Menu/FilesTab.Maps.Heading.Text" />
                </ui:Instance>
                <ui:Instance template="PathSelector" name="shapes">
                    <ui:AttributeOverrides element-name="heading" text="@Menu/FilesTab.Shapes.Heading.Text" />
                </ui:Instance>
                <ui:Instance template="PathSelector" name="physics">
                    <ui:AttributeOverrides element-name="heading" text="@Menu/FilesTab.Physics.Heading.Text" />
                </ui:Instance>
                <ui:Instance template="PathSelector" name="sounds">
                    <ui:AttributeOverrides element-name="heading" text="@Menu/FilesTab.Sounds.Heading.Text" />
                </ui:Instance>
                <!-- Aleph One only: the scenario's Plugins and Scripts folders (whose MML is applied), and which plugins are on -->
                <ui:VisualElement class="fp-separator fp-separator--horizontal fp-files__mml-separator" />
                <ui:Instance template="PathSelector" name="plugins" class="fp-aleph-one-only fp-files__mml" tooltip="@Menu/FilesTab.Plugins.Tooltip">
                    <ui:AttributeOverrides element-name="heading" text="@Menu/FilesTab.Plugins.Heading.Text" />
                </ui:Instance>
                <ui:Instance template="PathSelector" name="scripts" class="fp-aleph-one-only fp-files__mml" tooltip="@Menu/FilesTab.Scripts.Tooltip">
                    <ui:AttributeOverrides element-name="heading" text="@Menu/FilesTab.Scripts.Heading.Text" />
                </ui:Instance>
                <ui:VisualElement class="fp-aleph-one-only fp-files__mml">
                    <ui:DropdownField name="plugin-list" class="fp-display-options fp-files__plugin-list" tooltip="@Menu/FilesTab.PluginList.Tooltip" />
                </ui:VisualElement>
            </ui:Instance>
        </ui:VisualElement>
        <ui:VisualElement class="fp-separator fp-separator--horizontal" />
        <ui:VisualElement class="fp-box fp-box--padded fp-files__levels">
            <ui:ListView name="levels" fixed-item-height="35" selection-type="Single" class="fp-scroll fp-level-list" />
            <!-- After the levels: adds one to the end of the loaded map file (grayed out while none is loaded) -->
            <ui:Instance template="Button" name="new-level" class="fp-files__new-level" tooltip="@Menu/FilesTab.NewLevel.Tooltip">
                <ui:AttributeOverrides element-name="control" text="@Menu/FilesTab.NewLevel.Control.Text" />
            </ui:Instance>
        </ui:VisualElement>
        <!-- Shown in the menu's row of actions -->
        <ui:VisualElement name="actions" class="fp-files__actions" picking-mode="Ignore">
            <ui:VisualElement class="fp-grow" picking-mode="Ignore" />
            <ui:Instance template="Button" name="load" class="fp-files__load">
                <ui:AttributeOverrides element-name="control" text="@Menu/FilesTab.Load.Control.Text" />
            </ui:Instance>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
