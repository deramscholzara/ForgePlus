<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Template name="ScrollArea" src="../Templates/ScrollArea.uxml" />
    <ui:Template name="Button" src="../Templates/Button.uxml" />
    <ui:VisualElement class="fp-grow" picking-mode="Ignore">
        <ui:VisualElement class="fp-box fp-settings__options">
            <!-- A header for each category, then a row for each of its inputs (InputsTabPanel) -->
            <ui:Instance template="ScrollArea" name="entries" class="fp-grow fp-scroll--spaced" />
            <!-- At the bottom of the inputs, centered -->
            <ui:VisualElement class="fp-settings__actions" picking-mode="Ignore">
                <ui:Instance template="Button" name="reset-all" class="fp-settings__reset" tooltip="@Menu/InputsTab.ResetAll.Tooltip">
                    <ui:AttributeOverrides element-name="control" text="@Menu/InputsTab.ResetAll.Control.Text" />
                </ui:Instance>
            </ui:VisualElement>
        </ui:VisualElement>
        <!-- Moved over the whole UI while a binding waits for its key or button, which keeps the click (for a mouse
             button) from also clicking what's under it (InputsTabPanel) -->
        <ui:VisualElement name="rebinding-layer" class="fp-inputs__rebinding-layer">
            <ui:VisualElement class="fp-box fp-dialog">
                <ui:Label name="rebinding-title" class="fp-dialog__header" />
                <ui:Label text="@Menu/InputsTab.Rebinding.Message.Text" class="fp-dialog__message fp-inputs__rebinding-message" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
