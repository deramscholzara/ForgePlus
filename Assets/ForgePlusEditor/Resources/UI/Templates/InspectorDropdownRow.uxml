<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- A choice from a list; an instance is named after the inspector property it edits, whose <Name>Choices property
         lists the choices. It's grayed out while the property can't be set, or while its Is<Name>Editable property is false -->
    <ui:VisualElement class="fp-inspector-row fp-template">
        <ui:Label name="label" text="Label:" class="fp-inspector-row__label" />
        <ui:VisualElement class="fp-inspector-row__value-area">
            <ui:DropdownField name="value" class="fp-inspector-dropdown" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
