<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- An item in the error list (twice a level item's height): what's wrong and how to fix it, and, for an
         auto-fixable error, a button that fixes it (without which the text takes the button's place too) -->
    <ui:VisualElement class="fp-error-item fp-template">
        <ui:Label name="description" text="Description" class="fp-error-item__description" />
        <ui:Button name="fix" text="Fix" class="fp-button fp-error-item__fix" />
    </ui:VisualElement>
</ui:UXML>
