<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- Three whole numbers, such as a position's X, Y and Z (each committed on return or leaving it); an instance is named
         after the triple, and its fields edit the inspector's <Name>X, <Name>Y and <Name>Z properties (as a pair's do). It's
         grayed out while they can't be set, or while its Is<Name>Editable property is false. -->
    <ui:VisualElement class="fp-inspector-row fp-template">
        <ui:Label name="label" text="Label:" class="fp-inspector-row__label" />
        <ui:VisualElement class="fp-inspector-row__value-area fp-inspector-row__value-area--row">
            <ui:Label text="@Common/InspectorIntegerPairRow.X.Text" class="fp-inspector-pair-label" />
            <ui:IntegerField name="X" is-delayed="true" class="fp-inspector-pair-field fp-inspector-range-field" />
            <ui:Label text="@Common/InspectorIntegerPairRow.Y.Text" class="fp-inspector-pair-label fp-inspector-pair-label--second" />
            <ui:IntegerField name="Y" is-delayed="true" class="fp-inspector-pair-field fp-inspector-range-field" />
            <ui:Label text="@Common/InspectorIntegerTripleRow.Z.Text" class="fp-inspector-pair-label fp-inspector-pair-label--second" />
            <ui:IntegerField name="Z" is-delayed="true" class="fp-inspector-pair-field fp-inspector-range-field" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
