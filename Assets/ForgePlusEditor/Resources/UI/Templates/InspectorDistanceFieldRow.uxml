<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:fp="ForgePlus.UI">
    <!-- A world distance (such as "6 and 9/1024"), committed on return or leaving it; an instance is named after the
         inspector property it edits, and is grayed out while that property can't be set -->
    <ui:VisualElement class="fp-inspector-row fp-template">
        <ui:Label name="label" text="Label:" class="fp-inspector-row__label" />
        <ui:VisualElement class="fp-inspector-row__value-area">
            <fp:WorldDistanceField name="value" is-delayed="true" class="fp-inspector-text-field" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
