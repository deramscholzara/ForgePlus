<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- A whole-number field (committed on return or leaving it); an instance is named after the inspector property it
         edits, and is grayed out while that property can't be set -->
    <ui:VisualElement class="fp-inspector-row fp-template">
        <ui:Label name="label" text="Label:" class="fp-inspector-row__label" />
        <ui:VisualElement class="fp-inspector-row__value-area">
            <ui:IntegerField name="value" is-delayed="true" class="fp-inspector-text-field" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
